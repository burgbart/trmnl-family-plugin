{
  "$schema": "https://design-tokens.org/schema/dtcg-draft.json",
  "$description": "trmnl-home design system tokens for non-TRMNL views (web, widget, desktop, terminal-adjacent surfaces). Style based on heimdalsecurity.com: friendly modern SaaS — deep navy, vivid pink CTAs, blue gradients, rounded shapes. Values extracted from Heimdal's production CSS on 2026-07-31.",
  "color": {
    "brand": {
      "pink": { "$value": "#FF2F70", "$type": "color", "$description": "Primary brand accent. CTAs, highlights, active states." },
      "pink-deep": { "$value": "#FF2626", "$type": "color", "$description": "Gradient end of the primary CTA gradient (with brand.pink)." },
      "navy": { "$value": "#0A1A65", "$type": "color", "$description": "Primary dark. Headings, dark sections, footer." },
      "blue": { "$value": "#0065FE", "$type": "color", "$description": "Secondary accent. Links, icons, interactive elements." },
      "blue-light": { "$value": "#8EBEFF", "$type": "color", "$description": "Gradient start for blue gradients, decorative accents." },
      "purple": { "$value": "#A459FF", "$type": "color", "$description": "Tertiary accent for tags, charts, differentiation." },
      "purple-dark": { "$value": "#351E66", "$type": "color", "$description": "Deep purple for dark decorative surfaces." }
    },
    "surface": {
      "base": { "$value": "#FFFFFF", "$type": "color", "$description": "Default page/card background." },
      "tinted": { "$value": "#E8EAFD", "$type": "color", "$description": "Pale lavender section tint, alternating bands." },
      "dark": { "$value": "{color.brand.navy}", "$type": "color", "$description": "Dark section background." }
    },
    "text": {
      "primary": { "$value": "{color.brand.navy}", "$type": "color", "$description": "Headings and body text on light surfaces." },
      "secondary": { "$value": "#ACB3D3", "$type": "color", "$description": "Muted blue-gray. Captions, metadata, secondary text on light; body text on dark." },
      "inverse": { "$value": "#FFFFFF", "$type": "color", "$description": "Text on dark/brand backgrounds." },
      "link": { "$value": "{color.brand.blue}", "$type": "color", "$description": "Inline links." }
    },
    "semantic": {
      "success": { "$value": "#6DCE43", "$type": "color", "$description": "Completed, done, positive states." },
      "success-bright": { "$value": "#83E31E", "$type": "color", "$description": "Bright variant of success for highlights/badges." },
      "error": { "$value": "{color.brand.pink-deep}", "$type": "color", "$description": "Errors and failed states. Reuses the deep pink-red." },
      "warning": { "$value": "#FF5F00", "$type": "color", "$description": "Warnings, due-soon states." },
      "info": { "$value": "{color.brand.blue}", "$type": "color", "$description": "Informational states." }
    },
    "gradient": {
      "cta": { "$value": "linear-gradient(90deg, {color.brand.pink} 0%, {color.brand.pink-deep} 100%)", "$type": "gradient", "$description": "Primary CTA button gradient." },
      "blue": { "$value": "linear-gradient(180deg, {color.brand.blue-light} 0%, {color.brand.blue} 100%)", "$type": "gradient", "$description": "Blue decorative gradient (icons, hero art, charts)." }
    }
  },
  "theme": {
    "dark": {
      "$description": "Dark theme overrides. Apply on top of the light defaults; brand accents (pink, gradients) are unchanged. Page background goes deeper than brand.navy; cards/panels use raised. Interactive text (links, times) switches to blue-light for contrast.",
      "surface": {
        "base": { "$value": "#060C30", "$type": "color", "$description": "Dark page background, deeper than brand.navy." },
        "raised": { "$value": "#121E5C", "$type": "color", "$description": "Dark cards, panels, swatch bodies." },
        "tinted": { "$value": "#0D1648", "$type": "color", "$description": "Dark alternating section band (replaces lavender)." }
      },
      "text": {
        "primary": { "$value": "#FFFFFF", "$type": "color", "$description": "Headings and body on dark surfaces." },
        "secondary": { "$value": "{color.text.secondary}", "$type": "color", "$description": "Unchanged; the muted blue-gray reads well on dark." }
      },
      "interactive": { "$value": "{color.brand.blue-light}", "$type": "color", "$description": "Links, secondary buttons, highlighted values on dark (brand.blue is too dark for text on navy)." },
      "border": { "$value": "rgba(172, 179, 211, 0.25)", "$type": "color", "$description": "Hairline borders/dividers on dark surfaces." }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "'Nunito Sans', sans-serif", "$type": "fontFamily", "$description": "Headings, numbers, display text. Rounded geometric feel." },
      "body": { "$value": "'Inter', sans-serif", "$type": "fontFamily", "$description": "Body copy, labels, UI text." }
    },
    "size": {
      "hero": { "$value": "4rem", "$type": "dimension", "$description": "Hero headlines (65px)." },
      "h1": { "$value": "3rem", "$type": "dimension" },
      "h2": { "$value": "2.5rem", "$type": "dimension" },
      "h3": { "$value": "2rem", "$type": "dimension" },
      "h4": { "$value": "1.5rem", "$type": "dimension" },
      "lead": { "$value": "1.375rem", "$type": "dimension", "$description": "Lead/intro paragraphs (22px)." },
      "body-lg": { "$value": "1.25rem", "$type": "dimension", "$description": "Emphasized body (20px)." },
      "body": { "$value": "1.125rem", "$type": "dimension", "$description": "Default body (18px)." },
      "small": { "$value": "1rem", "$type": "dimension", "$description": "Secondary text, labels (16px)." },
      "caption": { "$value": "0.875rem", "$type": "dimension", "$description": "Captions, metadata (14px)." }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" },
      "extrabold": { "$value": "800", "$type": "fontWeight", "$description": "Display headings and big numbers." }
    },
    "lineHeight": {
      "tight": { "$value": "1.15", "$type": "number", "$description": "Headings." },
      "normal": { "$value": "1.6", "$type": "number", "$description": "Body copy." }
    }
  },
  "radius": {
    "small": { "$value": "8px", "$type": "dimension", "$description": "Inputs, small cards, chips." },
    "card": { "$value": "18px", "$type": "dimension", "$description": "Cards and panels (1.125rem)." },
    "large": { "$value": "28px", "$type": "dimension", "$description": "Hero panels, large containers." },
    "pill": { "$value": "30px", "$type": "dimension", "$description": "Buttons, badges. Fully rounded look." }
  },
  "shadow": {
    "card": { "$value": "0px 6px 12px rgba(0, 56, 255, 0.15)", "$type": "shadow", "$description": "Default card shadow, blue-tinted." },
    "raised": { "$value": "0 12px 20px rgba(1, 22, 55, 0.25)", "$type": "shadow", "$description": "Elevated/hover state, navy-tinted." },
    "glow": { "$value": "0 0 40px 5px rgba(72, 171, 224, 0.5)", "$type": "shadow", "$description": "Blue glow for featured/hero elements." }
  },
  "spacing": {
    "3xs": { "$value": "4px", "$type": "dimension" },
    "2xs": { "$value": "8px", "$type": "dimension" },
    "xs": { "$value": "12px", "$type": "dimension" },
    "sm": { "$value": "16px", "$type": "dimension" },
    "md": { "$value": "24px", "$type": "dimension" },
    "lg": { "$value": "32px", "$type": "dimension" },
    "xl": { "$value": "48px", "$type": "dimension" },
    "2xl": { "$value": "64px", "$type": "dimension" },
    "3xl": { "$value": "96px", "$type": "dimension", "$description": "Section padding." }
  },
  "motion": {
    "$description": "Animation tokens. Motion is subtle and functional: short, ease-out, and always honor prefers-reduced-motion. Used for hover lifts, entrances, and state changes — never decorative looping animation on data views.",
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration", "$description": "Micro-interactions: hover lifts, color changes." },
      "normal": { "$value": "250ms", "$type": "duration", "$description": "Default transitions: toggles, tabs, tooltips." },
      "slow": { "$value": "400ms", "$type": "duration", "$description": "Entrances and modal/panel reveals." }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier", "$description": "Default for elements moving within the screen." },
      "entrance": { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$type": "cubicBezier", "$description": "Decelerating — elements entering the screen." },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "cubicBezier", "$description": "Accelerating — elements leaving the screen." }
    },
    "keyframes": {
      "fade-up": {
        "$description": "Default entrance for cards, list items, toasts. Pairs with duration.slow + easing.entrance.",
        "from": { "$value": "opacity: 0; transform: translateY(16px)", "$type": "string" },
        "to": { "$value": "opacity: 1; transform: none", "$type": "string" }
      }
    }
  }
}
